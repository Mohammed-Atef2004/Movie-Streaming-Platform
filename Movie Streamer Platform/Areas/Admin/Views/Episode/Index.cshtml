@using BLL.ViewModels
@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<EpisodeVM>

@{
    ViewBag.PageTitle = "Episode Management";
    ViewBag.CardTitle = "View Episodes";
    var filterSeriesId = ViewBag.FilterSeriesId as int?;
}

<style>
    /* Admin Dark Theme Overrides */
    .card.shadow-lg {
        background-color: var(--admin-dark-surface);
        color: var(--admin-text-color);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .table {
        color: var(--admin-text-color);
    }

        .table > :not(caption) > * > * {
            background-color: transparent;
            color: var(--admin-text-color);
            border-color: rgba(255, 255, 255, 0.1);
        }

    thead th {
        color: var(--admin-link-color);
        text-transform: uppercase;
        font-size: .8rem;
        letter-spacing: .05em;
    }

    .form-select {
        background-color: #333 !important;
        border: 1px solid #555 !important;
        color: var(--admin-text-color) !important;
    }

    .btn-primary {
        background-color: var(--admin-active-color) !important;
        border-color: var(--admin-active-color) !important;
        color: #fff !important;
    }

    .btn-outline-secondary {
        border-color: #555 !important;
        color: var(--admin-text-color) !important;
    }

        .btn-outline-secondary:hover {
            background-color: #555 !important;
            color: #fff !important;
        }

    .btn-outline-danger {
        border-color: #555 !important;
        color: var(--admin-text-color) !important;
    }

        .btn-outline-danger:hover {
            background-color: var(--admin-active-color) !important;
            border-color: var(--admin-active-color) !important;
            color: #fff !important;
        }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold text-white">@ViewBag.CardTitle</h2>
    <a class="btn btn-primary" asp-area="Admin" asp-controller="Episode" asp-action="Create" asp-route-seriesId="@filterSeriesId">
        <i class="bi bi-plus-circle"></i> Add New Episode
    </a>
</div>

<div class="card shadow-lg border-0 rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-area="Admin" asp-controller="Episode" asp-action="Index" class="d-flex align-items-center gap-3">
            <label class="fw-bold text-nowrap" style="color: var(--admin-text-color);">Filter by series:</label>
            <select name="seriesId" class="form-select" style="max-width: 340px;">
                <option value="">All Series</option>
                @foreach (var s in ViewBag.SeriesList as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>())
                {
                    <option value="@s.Value" selected="@(filterSeriesId != null && s.Value == filterSeriesId.Value.ToString())">@s.Text</option>
                }
            </select>
            <button type="submit" class="btn btn-outline-secondary">
                <i class="bi bi-funnel"></i> Filter
            </button>
        </form>
    </div>
</div>

<div class="card shadow-lg border-0 rounded-3">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-film display-4 d-block mb-3"></i>
                No episodes found. Use the button above to add one.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Title</th>
                            <th>Series</th>
                            <th>Season</th>
                            <th>Episode</th>
                            <th>Views</th>
                            <th>Downloads</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold">@item.Title</div>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <div class="small text-muted">@(item.Description.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description)</div>
                                    }
                                </td>
                                <td>@(item.Series?.Title ?? $"Series #{item.SeriesId}")</td>
                                <td>@item.SeasonNumber</td>
                                <td>@item.EpisodeNumber</td>
                                <td>@(item.ViewCount ?? 0)</td>
                                <td>@item.DownloadCount</td>
                                <td class="text-end pe-4">
                                    <a href="/Admin/Episode/Edit/@item.Id" class="btn btn-outline-secondary btn-sm" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form action="/Admin/Episode/Delete/@item.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete the episode &quot;@item.Title&quot;?');">
                                        <input type="hidden" name="seriesId" value="@item.SeriesId" />
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
