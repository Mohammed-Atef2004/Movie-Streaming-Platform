@using BLL.ViewModels
@model IEnumerable<MovieVM>

@{
    ViewData["Title"] = "Discover";
}

<section class="stream-hero">
    <div class="stream-hero__scrim"></div>
    <div class="container stream-hero__content">
        <div class="stream-hero__copy" data-aos="fade-up">
            <span class="stream-eyebrow"><i class="bi bi-stars"></i> THE OPEN MOVIE COLLECTION</span>
            <h1>Stories worth<br><span>staying in for.</span></h1>
            <p>Discover beautifully made films, unforgettable series, and independent stories from creators around the world.</p>
            <div class="stream-hero__actions">
                <a asp-controller="Movies" asp-action="Index" class="btn btn-stream-primary">
                    Explore movies <i class="bi bi-arrow-up-right"></i>
                </a>
                <a asp-controller="Series" asp-action="Index" class="btn btn-stream-secondary">
                    Browse series
                </a>
            </div>
            <div class="stream-hero__note">
                <span class="stream-hero__note-icon"><i class="bi bi-play-fill"></i></span>
                <span>Independent films. A bigger screen for every story.</span>
            </div>
        </div>
    </div>
    <a class="stream-hero__scroll" href="#featured" aria-label="Scroll to featured movies">
        <span>Explore the collection</span>
        <i class="bi bi-arrow-down"></i>
    </a>
</section>

<section id="featured" class="home-featured section">
    <div class="container">
        <div class="stream-section-heading">
            <div>
                <span class="stream-eyebrow">HANDPICKED FOR YOU</span>
                <h2>Find your next favorite</h2>
                <p>A few good stories to get your watchlist started.</p>
            </div>
            <a asp-controller="Movies" asp-action="Index" class="stream-text-link">
                View all movies <i class="bi bi-arrow-up-right"></i>
            </a>
        </div>

        @if (Model?.Any() == true)
        {
            <div class="row g-4">
                @foreach (var movie in Model)
                {
                    <div class="col-xl-3 col-lg-4 col-md-6">
                        <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id" class="movie-card-link">
                            <article class="movie-card">
                                <div class="movie-img-wrapper">
                                    <img src="@ImageUrlHelper.ForDisplay(movie.ImageUrl)"
                                         class="movie-poster"
                                         alt="@movie.Title poster"
                                         loading="lazy"
                                         decoding="async"
                                         onerror="this.onerror=null;this.src='/Images/placeholder.png';" />
                                    <span class="movie-card__tag">@(movie.IsFree ? "FREE TO WATCH" : "MEMBERS PICK")</span>
                                </div>
                                <div class="movie-content">
                                    <div class="movie-card__meta">
                                        <span>@movie.Category?.Name</span>
                                        <span><i class="bi bi-star-fill"></i> @movie.Rating.ToString("0.0")</span>
                                    </div>
                                    <h3 class="movie-title">@movie.Title</h3>
                                    <p class="movie-desc">
                                        @(string.IsNullOrWhiteSpace(movie.Description)
                                            ? "A story waiting to be discovered."
                                            : movie.Description)
                                    </p>
                                    <span class="movie-card__link">Discover film <i class="bi bi-arrow-right"></i></span>
                                </div>
                            </article>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="stream-empty-state">
                <i class="bi bi-film"></i>
                <h3>Your next favorite is on its way.</h3>
                <p>Check back soon for new films in the collection.</p>
            </div>
        }
    </div>
</section>
