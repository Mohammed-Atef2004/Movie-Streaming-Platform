@using BLL.ViewModels
@model SeriesVM

@{
    ViewData["Title"] = $"Watch {Model.Title}";
    var episodes = ViewBag.Episodes as IEnumerable<EpisodeVM> ?? Enumerable.Empty<EpisodeVM>();
    var current = ViewBag.CurrentEpisode as EpisodeVM;
    var seasons = episodes
        .GroupBy(episode => episode.SeasonNumber < 1 ? 1 : episode.SeasonNumber)
        .OrderBy(group => group.Key)
        .Select(group => new
        {
            Number = group.Key,
            Episodes = group.OrderBy(episode => episode.EpisodeNumber < 1 ? int.MaxValue : episode.EpisodeNumber)
                .ThenBy(episode => episode.Id)
                .ToList()
        })
        .ToList();
}

<section class="watch-page">
    <div class="container">
        <a asp-controller="Series" asp-action="Details" asp-route-id="@Model.Id" class="watch-back">
            <i class="bi bi-arrow-left"></i> Back to series
        </a>

        <header class="watch-heading">
            <span class="stream-eyebrow">NOW PLAYING</span>
            <h1>@Model.Title</h1>
            @if (current != null)
            {
                <p>Season @Math.Max(current.SeasonNumber, 1) · Episode @(current.EpisodeNumber > 0 ? current.EpisodeNumber : 1) — @current.Title</p>
            }
        </header>

        <div class="watch-layout">
            <section class="watch-main">
                @if (current != null && !string.IsNullOrWhiteSpace(current.VideoUrl))
                {
                    <div class="ratio ratio-16x9 watch-player">
                        <iframe src="@current.VideoUrl"
                                title="@current.Title player"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                allowfullscreen>
                        </iframe>
                    </div>
                    <div class="watch-controls">
                        <p>@(current.Description ?? "Continue watching this episode.")</p>
                        <a asp-controller="Series" asp-action="Download" asp-route-id="@Model.Id" asp-route-episodeId="@current.Id"
                           class="watch-download">
                            <i class="bi bi-download"></i> Download episode
                        </a>
                    </div>
                }
                else
                {
                    <div class="watch-unavailable">
                        <i class="bi bi-play-btn"></i>
                        <h2>This episode isn't available yet</h2>
                        <p>Choose another episode or check back later.</p>
                    </div>
                }
            </section>

            <aside class="watch-episodes">
                <div class="watch-episodes__heading">
                    <div>
                        <span class="stream-eyebrow">UP NEXT</span>
                        <h2>Episodes</h2>
                    </div>
                    <span>@episodes.Count() total</span>
                </div>

                @if (seasons.Count == 0)
                {
                    <p class="watch-empty">No episodes have been added to this series yet.</p>
                }
                else
                {
                    <div class="watch-season-list">
                        @foreach (var season in seasons)
                        {
                            <section class="watch-season">
                                <h3>Season @season.Number</h3>
                                @for (var index = 0; index < season.Episodes.Count; index++)
                                {
                                    var episode = season.Episodes[index];
                                    var episodeNumber = episode.EpisodeNumber > 0 ? episode.EpisodeNumber : index + 1;
                                    <a asp-controller="Series" asp-action="View" asp-route-id="@Model.Id" asp-route-episodeId="@episode.Id"
                                       class="watch-episode @(current?.Id == episode.Id ? "active" : "")"
                                       aria-current="@(current?.Id == episode.Id ? "true" : null)">
                                        <span class="watch-episode__icon"><i class="bi @(current?.Id == episode.Id ? "bi-volume-up-fill" : "bi-play-fill")"></i></span>
                                        <span class="watch-episode__details">
                                            <strong>@episodeNumber. @episode.Title</strong>
                                            <small>@(string.IsNullOrWhiteSpace(episode.Description) ? $"Season {season.Number}" : episode.Description)</small>
                                        </span>
                                    </a>
                                }
                            </section>
                        }
                    </div>
                }
            </aside>
        </div>
    </div>
</section>
