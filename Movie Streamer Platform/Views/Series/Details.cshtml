@using BLL.ViewModels
@model SeriesVM

@{
    ViewData["Title"] = $"{Model.Title} - Series";
    var posterUrl = ImageUrlHelper.ForDisplay(Model.ImageUrl);
    var episodes = ViewBag.Episodes as IEnumerable<EpisodeVM> ?? Enumerable.Empty<EpisodeVM>();
    var seasons = episodes
        .GroupBy(episode => episode.SeasonNumber < 1 ? 1 : episode.SeasonNumber)
        .OrderBy(group => group.Key)
        .Select(group => new
        {
            Number = group.Key,
            Episodes = group.OrderBy(episode => episode.EpisodeNumber < 1 ? int.MaxValue : episode.EpisodeNumber)
                .ThenBy(episode => episode.Id)
                .ToList()
        })
        .ToList();
    var firstEpisode = seasons.SelectMany(season => season.Episodes).FirstOrDefault();
    var episodeCount = seasons.Sum(season => season.Episodes.Count);
}

<section class="series-hero" style="--series-art: url('@posterUrl')">
    <div class="container series-hero__content">
        <a asp-controller="Series" asp-action="Index" class="series-back-link">
            <i class="bi bi-arrow-left"></i> All series
        </a>
        <span class="stream-eyebrow">SERIES SPOTLIGHT</span>
        <h1>@Model.Title</h1>
        <div class="series-hero__meta">
            <span>@Model.Category?.Name</span>
            <span>@seasons.Count season@(seasons.Count == 1 ? "" : "s")</span>
            <span>@episodeCount episodes</span>
            <span class="series-access-badge">@(Model.IsFree == true ? "FREE TO WATCH" : "MEMBERS PICK")</span>
        </div>
        <p class="series-hero__description">
            @(string.IsNullOrWhiteSpace(Model.Description)
                ? "A new world is waiting in every episode."
                : Model.Description)
        </p>
        <div class="series-hero__actions">
            @if (firstEpisode != null)
            {
                <a asp-controller="Series" asp-action="View" asp-route-id="@Model.Id" asp-route-episodeId="@firstEpisode.Id"
                   class="btn btn-stream-primary">
                    <i class="bi bi-play-fill"></i> Play series
                </a>
            }
            else
            {
                <span class="btn btn-stream-primary disabled" aria-disabled="true">
                    <i class="bi bi-hourglass-split"></i> Episodes coming soon
                </span>
            }
            <span class="series-hero__views"><i class="bi bi-eye"></i> @Model.ViewCount views</span>
        </div>
    </div>
</section>

<section class="series-details-section">
    <div class="container">
        <div class="series-details-layout">
            <section class="series-seasons" aria-label="Seasons and episodes">
                <div class="series-section-heading">
                    <div>
                        <span class="stream-eyebrow">THE EPISODE GUIDE</span>
                        <h2>Seasons &amp; episodes</h2>
                    </div>
                    @if (seasons.Count > 0)
                    {
                        <span class="series-total-episodes">@episodeCount episodes</span>
                    }
                </div>

                @if (seasons.Count == 0)
                {
                    <div class="stream-empty-state">
                        <i class="bi bi-collection-play"></i>
                        <h3>Episodes are on their way</h3>
                        <p>There aren't any episodes available for this series yet.</p>
                    </div>
                }
                else
                {
                    @foreach (var season in seasons)
                    {
                        <details class="season-panel" open="@(season.Number == seasons[0].Number ? "open" : null)">
                            <summary class="season-panel__summary">
                                <span>
                                    <strong>Season @season.Number</strong>
                                    <small>@season.Episodes.Count episode@(season.Episodes.Count == 1 ? "" : "s")</small>
                                </span>
                                <i class="bi bi-chevron-down"></i>
                            </summary>
                            <div class="season-episodes">
                                @for (var index = 0; index < season.Episodes.Count; index++)
                                {
                                    var episode = season.Episodes[index];
                                    var episodeNumber = episode.EpisodeNumber > 0 ? episode.EpisodeNumber : index + 1;
                                    <a asp-controller="Series" asp-action="View" asp-route-id="@Model.Id" asp-route-episodeId="@episode.Id"
                                       class="season-episode">
                                        <span class="season-episode__play"><i class="bi bi-play-fill"></i></span>
                                        <span class="season-episode__number">S@season.Number:E@episodeNumber</span>
                                        <span class="season-episode__copy">
                                            <strong>@episode.Title</strong>
                                            <small>@(string.IsNullOrWhiteSpace(episode.Description) ? "Play episode" : episode.Description)</small>
                                        </span>
                                        <span class="season-episode__views"><i class="bi bi-eye"></i> @(episode.ViewCount ?? 0)</span>
                                    </a>
                                }
                            </div>
                        </details>
                    }
                }
            </section>

            <aside class="series-sidebar">
                <div class="series-poster-card">
                    <img src="@posterUrl" alt="@Model.Title poster" loading="lazy" decoding="async"
                         onerror="this.onerror=null;this.src='/Images/placeholder.png';" />
                    <div>
                        <span class="stream-eyebrow">NOW STREAMING</span>
                        <h3>@Model.Title</h3>
                        <p>@(Model.IsFree == true ? "Available to watch for free." : "A members pick from the collection.")</p>
                    </div>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="series-list-actions">
                        <form asp-controller="Series" asp-action="ToggleFavorite" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="seriesId" value="@Model.Id" />
                            <button type="submit" class="series-action-button">
                                <i class="bi bi-heart"></i>
                                @(ViewBag.IsFavorite == true ? "Remove from favorites" : "Add to favorites")
                            </button>
                        </form>
                        <form asp-controller="Series" asp-action="ToggleWatchList" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="seriesId" value="@Model.Id" />
                            <button type="submit" class="series-action-button">
                                <i class="bi bi-bookmark-plus"></i>
                                @(ViewBag.IsInWatchList == true ? "Remove from My List" : "Add to My List")
                            </button>
                        </form>
                    </div>
                }
            </aside>
        </div>
    </div>
</section>
