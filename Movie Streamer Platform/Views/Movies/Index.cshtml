@using BLL.ViewModels
@model IEnumerable<MovieVM>

@{
    ViewData["Title"] = "Movies";
    var totalPages = (int)(ViewBag.TotalPages ?? 0);
    var currentPage = (int)(ViewBag.Page ?? 1);
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
}

<section class="catalog-hero catalog-hero--movies">
    <div class="container">
        <span class="stream-eyebrow">THE MOVIE COLLECTION</span>
        <h1>Make tonight<br><span>a movie night.</span></h1>
        <p>Find a new favorite from stories made to stay with you.</p>
    </div>
</section>

<section id="movies" class="movies-section section catalog-section">
    <div id="movies-filters" class="container catalog-filters">
        <form method="get" asp-action="Index" class="filter-form">
            <label class="input-group filter-search">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text"
                       name="search"
                       class="form-control filter-input"
                       placeholder="Search movies..."
                       value="@ViewBag.Search"
                       aria-label="Search movies" />
            </label>

            <label class="input-group filter-category">
                <span class="input-group-text"><i class="bi bi-grid"></i></span>
                <select name="categoryId" class="form-select filter-select" aria-label="Filter by category">
                    <option value="">All categories</option>
                    @if (ViewBag.Categories is IEnumerable<CategoryVM> categories)
                    {
                        foreach (var category in categories)
                        {
                            <option value="@category.Id" selected="@(ViewBag.CategoryId != null && (int)ViewBag.CategoryId == category.Id)">
                                @category.Name
                            </option>
                        }
                    }
                </select>
            </label>

            <label class="input-group filter-sort">
                <span class="input-group-text"><i class="bi bi-sort-down"></i></span>
                <select name="sortBy" class="form-select filter-select" aria-label="Sort movies">
                    <option value="">Recommended</option>
                    <option value="views" selected="@(ViewBag.SortBy as string == "views")">Most viewed</option>
                    <option value="rating" selected="@(ViewBag.SortBy as string == "rating")">Top rated</option>
                    <option value="downloads" selected="@(ViewBag.SortBy as string == "downloads")">Most downloaded</option>
                </select>
            </label>

            <button type="submit" class="btn btn-filter">
                <i class="bi bi-sliders2"></i> Apply filters
            </button>
        </form>
    </div>

    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="catalog-results">
            <p class="catalog-count">@totalCount films</p>
        </div>

        @if (Model.Any())
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6">
                        <a asp-area="" asp-controller="Movies" asp-action="Details" asp-route-id="@item.Id" class="movie-card-link">
                            <article class="movie-card">
                                <div class="movie-img-wrapper">
                                    <img src="@ImageUrlHelper.ForDisplay(item.ImageUrl)"
                                         class="movie-poster"
                                         alt="@item.Title poster"
                                         loading="lazy"
                                         decoding="async"
                                         onerror="this.onerror=null;this.src='/Images/placeholder.png';" />
                                    <div class="movie-overlay">
                                        <span class="movie-category-badge">@(item.Category?.Name ?? "Featured")</span>
                                    </div>
                                </div>

                                <div class="movie-content">
                                    <div class="movie-card__meta">
                                        <span>@item.Year</span>
                                        <span><i class="bi bi-star-fill"></i> @item.Rating.ToString("0.0")</span>
                                    </div>
                                    <h2 class="movie-title">@item.Title</h2>
                                    <p class="movie-desc">
                                        @(string.IsNullOrWhiteSpace(item.Description)
                                            ? "A story waiting to be discovered."
                                            : (item.Description.Length > 120
                                                ? item.Description.Substring(0, 120) + "..."
                                                : item.Description))
                                    </p>
                                    <span class="movie-card__link">View details <i class="bi bi-arrow-right"></i></span>
                                </div>
                            </article>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="stream-empty-state">
                <i class="bi bi-search"></i>
                <h3>No movies found</h3>
                <p>Try a different title or clear one of the filters.</p>
            </div>
        }

        @if (totalPages > 1)
        {
            <nav aria-label="Movie pages" class="mt-5">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-categoryId="@ViewBag.CategoryId" asp-route-sortBy="@ViewBag.SortBy" asp-route-page="@(currentPage - 1)">Previous</a>
                    </li>
                    @for (int pageNumber = 1; pageNumber <= totalPages; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-categoryId="@ViewBag.CategoryId" asp-route-sortBy="@ViewBag.SortBy" asp-route-page="@pageNumber">@pageNumber</a>
                        </li>
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-categoryId="@ViewBag.CategoryId" asp-route-sortBy="@ViewBag.SortBy" asp-route-page="@(currentPage + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</section>
