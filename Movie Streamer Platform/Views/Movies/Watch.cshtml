@using BLL.ViewModels
@model MovieVM

@{
    ViewBag.PageTitle = $"Watch {Model?.Title}";
}

<style>
    .watch-page {
        background: #050505;
        min-height: 100vh;
        color: white;
        padding: 2rem 0 4rem;
    }

    .watch-player {
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,.1);
        box-shadow: 0 25px 80px rgba(0,0,0,.8);
        background: #000;
    }

    .watch-title {
        font-size: 2rem;
        font-weight: 800;
        color: white;
    }

    .watch-back {
        color: rgba(255,255,255,.7);
        text-decoration: none;
        font-weight: 600;
        transition: color .25s ease;
    }

        .watch-back:hover {
            color: #ffc107;
        }
</style>

<div class="watch-page">
    <div class="container">

        <a asp-controller="Movies" asp-action="Details" asp-route-id="@Model?.Id" class="watch-back">
            <i class="fas fa-arrow-left me-2"></i> Back to details
        </a>

        <h1 class="watch-title mt-3 mb-4">@Model?.Title</h1>

        @if (!string.IsNullOrWhiteSpace(Model?.MovieUrl))
        {
            <div class="ratio ratio-16x9 watch-player">
                <iframe src="@Model.MovieUrl"
                        title="@Model.Title player"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen>
                </iframe>
            </div>
        }
        else
        {
            <div class="alert alert-secondary" role="alert">
                <i class="fas fa-triangle-exclamation me-2"></i>
                This movie has no video available yet.
            </div>
        }

        <div class="d-flex flex-wrap align-items-center gap-3 mt-4">

            <span class="badge bg-warning text-dark px-3 py-2">
                <i class="fas fa-star me-1"></i> @Model?.Rating.ToString("0.0") / 10
            </span>

            <span class="badge bg-dark border px-3 py-2">
                <i class="fas fa-eye me-1"></i> @(Model?.Views ?? 0) views
            </span>

            <span class="badge @(Model?.IsFree == true ? "bg-success" : "bg-danger") px-3 py-2">
                @(Model?.IsFree == true ? "FREE" : "PREMIUM")
            </span>

        </div>

    </div>
</div>
